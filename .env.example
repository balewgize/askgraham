# ── backend (Python / FastAPI) ────────────────────────────────────────
# Copy to .env at the repo root. Both the app and alembic read this.
DATABASE_URL=postgresql+asyncpg://askgraham:askgraham@localhost:5433/askgraham

ENVIRONMENT=local
LOG_LEVEL=INFO
DEBUG=false

# Comma-separated. Empty means same-origin only.
CORS_ORIGINS=

# Used by `llm.py` in Phase 4+. Never required to serve essays or search.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── frontend (Next.js) ────────────────────────────────────────────────
# Only the TypeScript authoring scripts in frontend/scripts need these.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash